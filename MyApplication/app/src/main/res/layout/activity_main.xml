<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- タイトル -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/worker_title"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <!-- 作業者名ラベル -->
    <TextView
        android:id="@+id/tvWorkerNameLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/worker_name_label"
        android:textStyle="bold" />

    <!-- 作業者名入力 -->
    <EditText
        android:id="@+id/etWorkerName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/worker_name_hint"
        android:inputType="textPersonName"
        android:layout_marginBottom="12dp" />

    <!-- 設備点検チェックボックス -->
    <CheckBox
        android:id="@+id/cbEquipmentCheck"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/equipment_check" />

    <!-- 安全点検チェックボックス -->
    <CheckBox
        android:id="@+id/cbSafetyCheck"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/safety_check"
        android:layout_marginBottom="12dp" />

    <!-- 勤務シフト選択 -->
    <RadioGroup
        android:id="@+id/rgShift"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <RadioButton
            android:id="@+id/rbDayShift"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/day_shift"
            android:checked="true" />

        <RadioButton
            android:id="@+id/rbNightShift"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/night_shift"
            android:layout_marginStart="16dp" />

    </RadioGroup>

    <!-- 工程選択（Spinner） -->
    <Spinner
        android:id="@+id/spProcess"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:entries="@array/process_array"
        android:layout_marginBottom="12dp" />

    <!-- 作業内容詳細入力 -->
    <EditText
        android:id="@+id/etWorkDetail"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="top|start"
        android:hint="@string/worker_detail_hint"
        android:inputType="textMultiLine"
        android:layout_marginBottom="16dp" />

    <!-- 送信ボタン -->
    <Button
        android:id="@+id/btnSubmit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/submit_button" />

</LinearLayout>